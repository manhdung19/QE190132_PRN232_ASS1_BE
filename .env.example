# Set through the process environment or Render dashboard. Never commit a real value.
# ASP.NET Core does not automatically load this file.
DATABASE_URL=
# Optional alternative when DATABASE_URL is unset: Npgsql-format connection string.
ConnectionStrings__TaskTrack=
# Required at API startup; use at least 32 UTF-8 bytes. Set a real random value in Render.
JWT_SECRET=
# Optional: set true to expose Swagger UI outside Development.
Swagger__EnableInProduction=false
